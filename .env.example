# ============================================================================
# AI Engineer Practice Monorepo — root environment file (EXAMPLE)
# ----------------------------------------------------------------------------
# Copy this file to `.env` (which is gitignored) and fill in real values.
#   cp .env.example .env
#
# This file holds the BACKEND secrets/config shared by every Python service.
# It contains SAFE PLACEHOLDERS ONLY — never commit real secrets.
#
# NOTE: The frontend's own build-time base URLs (VITE_* variables) do NOT live
# here. They are the SPA's build-time config and belong in
# `apps/web/.env.local` (see `apps/web/.env.local.example`).
# ============================================================================

# ── LLM gateway (OpenAI-compatible) ─────────────────────────────────────────
# Base URL of the OpenAI-compatible gateway that fronts the model.
LLM_BASE_URL=http://localhost:3090/v1
# API key presented to the gateway.
LLM_API_KEY=your-llm-api-key-here
# Default model identifier used when a request does not specify one.
LLM_MODEL=claude-opus-4.7

# ── Web search provider (Tavily) ────────────────────────────────────────────
# API key for the Tavily Search API (used by web-agent and deep-research).
TAVILY_API_KEY=your-tavily-api-key-here

# ── Hugging Face (embeddings + image generation) ────────────────────────────
# Hugging Face access token (used for embeddings and image generation).
HF_TOKEN=your-hf-token-here

# ── Embeddings + vector store (Chroma) ──────────────────────────────────────
# Sentence-transformers model used to embed text via Hugging Face inference.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Local filesystem path for the Chroma persistent vector store.
CHROMA_PATH=./.chroma

# ── PostgreSQL history store (Database / History_Store) ─────────────────────
# Connection variables for the durable, browsable history database.
DB_HOST=localhost
DB_PORT=5432
DB_USER=ai_monorepo
DB_PASSWORD=changeme
DB_NAME=ai_monorepo_history

# Backend base URLs for the six AI mini-project services (Requirement 2.9).
#
# Vite only exposes variables matching its envPrefix ("VITE_") on
# import.meta.env, so these MUST be VITE_-prefixed. Copy this file to
# `.env.local` (gitignored) and adjust the URLs to where each backend runs.
# These are the URLs the SPA calls FROM THE BROWSER (host-published ports).

VITE_PLAYGROUND_URL="http://localhost:8001"
VITE_SUPPORT_URL="http://localhost:8002"
VITE_WEBAGENT_URL="http://localhost:8003"
VITE_DEEPRESEARCH_URL="http://localhost:8004"
VITE_IMAGE_URL="http://localhost:8005"
VITE_CAPSTONE_URL="http://localhost:8006"
